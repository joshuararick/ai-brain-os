# Copy this to .env and fill in your keys
# Never commit .env to Git

# OpenAI API Key (get from platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-key-here

# Perplexity API Key (get from perplexity.ai/settings/api)
PERPLEXITY_API_KEY=pplx-your-key-here

# Rally Point Bridge Token (generated by start-bridge-secure.ps1)
RALLY_POINT_BRIDGE_TOKEN=your-token-here

# Grok / xAI API Key (console.x.ai)
GROK_API_KEY=xai-your-key-here

# Gemini API Key (aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key-here
